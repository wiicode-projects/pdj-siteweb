# Copy to .env.local for overrides (gitignored via *.local)
#
# Vite injects VITE_* variables at build time.
# Set them in:
#   - .env.development  → npm run dev
#   - .env.production   → npm run build (local)
#   - Docker build-arg  → see Dockerfile + .github/workflows/ci-cd.yml
#
# Backoffice base URL (no trailing slash). /login and /register are appended in code.
#
# Environments:
#   local   → http://localhost:4250
#   dev     → https://pdj-backoffice-dev.wiicode.tech
#   prod    → https://backoffice.leplatdujour.ch
#
# API base URL (includes /api/v1):
#   local   → /api/v1 (Vite proxy → http://localhost:3039) or http://localhost:3039/api/v1
#   dev     → https://pdj-dev-api.wiicode.tech/api/v1
#   prod    → https://backoffice.leplatdujour.ch/api/v1

VITE_APP_ENV=local
VITE_RESTAURANT_PORTAL_URL=http://localhost:4250
VITE_API_URL=http://localhost:3039/api/v1
